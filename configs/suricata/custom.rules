# Regles Suricata personnalisees du labo (interface OPT1, segment attaquant 10.10.66.0/24)
alert icmp 10.10.66.0/24 any -> 192.168.1.0/24 any (msg:"LAB - Ping depuis le segment attaquant vers la victime"; itype:8; classtype:network-scan; sid:9000001; rev:1;)
alert tcp 10.10.66.0/24 any -> 192.168.1.0/24 any (msg:"LAB - Scan de ports TCP SYN depuis Kali vers la victime"; flags:S,12; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:9000002; rev:1;)
alert tcp 10.10.66.0/24 any -> 192.168.1.0/24 [445,3389,5985] (msg:"LAB - Tentative de connexion SMB/RDP/WinRM depuis le segment attaquant"; flags:S,12; threshold:type limit, track by_src, count 1, seconds 60; classtype:attempted-admin; sid:9000003; rev:1;)
alert http 10.10.66.0/24 any -> any any (msg:"LAB - User-Agent d outil offensif (sqlmap/nikto/nmap)"; http.user_agent; pcre:"/(sqlmap|nikto|nmap)/i"; classtype:web-application-attack; sid:9000004; rev:1;)
